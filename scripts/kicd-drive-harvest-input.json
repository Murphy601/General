  "pageFunction": "async function pageFunction(context) {\n  const { page, jQuery: $, request, log } = context;\n\n  const expandSelectors = [\n    \"[aria-expanded='false']\",\n    '.accordion-button',\n    '.elementor-tab-title',\n    'details:not([open]) > summary',\n  ].join(', ');\n\n  for (let round = 0; round < 8; round += 1) {\n    const handles = await page.$$(expandSelectors);\n    for (const handle of handles.slice(0, 25)) {\n      try {\n        await handle.click({ timeout: 1500 });\n        await page.waitForTimeout(250);\n      } catch (error) {}\n    }\n  }\n\n  await page.waitForTimeout(4000);\n\n  const html = await page.content();\n  const driveLinks = new Set();\n\n  $('iframe[src*=\"drive.google.com\"], a[href*=\"drive.google.com\"]').each((_, el) => {\n    const value = $(el).attr('src') || $(el).attr('href');\n    if (value) driveLinks.add(value);\n  });\n\n  const idRegex = /drive\\.google\\.com\\/file\\/d\\/([a-zA-Z0-9_-]+)/g;\n  let match;\n  while ((match = idRegex.exec(html)) !== null) {\n    driveLinks.add(`https://drive.google.com/file/d/${match[1]}/view`);\n  }\n\n  const pdfMeta = [];\n  const metaRegex = /\\{\"id\":\\s*\"([^\"]+)\",\\s*\"title\":\\s*\"([^\"]+)\",\\s*\"mimeType\":\\s*\"application\\\\\\/pdf\"\\}/g;\n  while ((match = metaRegex.exec(html)) !== null) {\n    pdfMeta.push({\n      fileId: match[1].replace(/\\\\_/g, '_'),\n      title: match[2],\n    });\n  }\n\n  log.info(`Found ${driveLinks.size} drive links on ${request.url}`);\n\n  return {\n    url: request.url,\n    driveLinks: [...driveLinks],\n    pdfMeta,\n  };\n}\n"
}
