  "crawlerType": "playwright:chrome",
  "maxCrawlDepth": 2,
  "maxCrawlPages": 400,
  "maxResults": 400,
  "dynamicContentWaitSecs": 8,
  "softWaitForSelector": "a[href*='wp-content/uploads'], .accordion, .elementor-accordion, h3, table",
  "clickElementsCssSelector": "[aria-expanded='false'], .accordion-button, .elementor-tab-title, details:not([open]) > summary",
  "includeUrlGlobs": [
    {
      "glob": "https://kicd.ac.ke/cbc-materials/**"
    },
    {
      "glob": "https://kicd.ac.ke/wp-content/uploads/**"
    }
  ],
  "excludeUrlGlobs": [
    {
      "glob": "https://kicd.ac.ke/**/feed/**"
    },
    {
      "glob": "https://kicd.ac.ke/**#*"
    }
  ],
  "useSitemaps": false,
  "respectRobotsTxtFile": true,
  "saveMarkdown": true,
  "saveContentTypes": "application/pdf",
  "htmlTransformer": "readableTextIfPossible",
  "removeCookieWarnings": true,
  "maxConcurrency": 4,
  "requestTimeoutSecs": 120,
  "proxyConfiguration": {
    "useApifyProxy": true
  },
  "pageFunction": "async function pageFunction({ page }) { await page.waitForTimeout(5000); const buttons = await page.locator(\"[aria-expanded=\"false\"], .accordion-button, .elementor-tab-title\").all(); for (const b of buttons.slice(0, 20)) { try { await b.click({ timeout: 2000 }); await page.waitForTimeout(500); } catch (e) {} } }"
}