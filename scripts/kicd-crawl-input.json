  "crawlerType": "playwright:chrome",
  "maxCrawlDepth": 1,
  "maxCrawlPages": 120,
  "maxResults": 120,
  "dynamicContentWaitSecs": 5,
  "softWaitForSelector": "a[href], table, .accordion, [role='button']",
  "clickElementsCssSelector": "[aria-expanded='false'], .accordion-button.collapsed, details:not([open]) > summary",
  "includeUrlGlobs": [
    "https://kicd.ac.ke/cbc-materials/**",
    "https://kicd.ac.ke/wp-content/uploads/**"
  ],
  "excludeUrlGlobs": [
    "https://kicd.ac.ke/**/feed/**",
    "https://kicd.ac.ke/**#*"
  ],
  "useSitemaps": false,
  "respectRobotsTxtFile": true,
  "saveMarkdown": true,
  "saveContentTypes": "application/pdf",
  "htmlTransformer": "readableText",
  "removeCookieWarnings": true,
  "maxConcurrency": 5,
  "requestTimeoutSecs": 90,
  "proxyConfiguration": {
    "useApifyProxy": true
  },
  "pageFunction": "async function pageFunction({ page }) {\n  await page.waitForTimeout(5000);\n}"
