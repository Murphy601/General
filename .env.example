# OpenRouter API — copy this file to .env and paste your real key
OPENAI_API_KEY=sk-or-v1-PASTE_YOUR_KEY_HERE
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_CHAT_MODEL=openai/gpt-4o-mini

# Optional local M-Pesa Daraja (live Worker uses wrangler secrets instead)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_ENV=sandbox

