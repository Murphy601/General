{
  "name": "kicd-cbc-crawler",
  "private": true,
  "type": "module",
  "scripts": {
    "crawl": "node scripts/run-kicd-crawl.mjs",
    "crawl:wait": "node scripts/run-kicd-crawl.mjs --wait",
    "crawl:status": "node scripts/check-kicd-crawl.mjs",
    "drive:harvest": "node scripts/run-kicd-drive-harvest.mjs",
    "drive:harvest:wait": "node scripts/run-kicd-drive-harvest.mjs --wait",
    "drive:extract": "node scripts/extract-drive-links.mjs --from-phase2",
    "drive:harvest:local": "node scripts/harvest-drive-links-local.mjs",
    "pdfs:download": "node scripts/download-kicd-pdfs.mjs",
    "pdfs:download:direct": "node scripts/download-kicd-pdfs.mjs --direct-only",
    "kec:harvest": "node scripts/harvest-kec-mirrors.mjs",
    "pdfs:download:kec": "node scripts/download-kicd-pdfs.mjs --kec-only",
    "drive:visual:generate": "node scripts/generate-drive-visual-input.mjs",
    "drive:visual:harvest": "node scripts/run-drive-visual-harvest.mjs",
    "drive:visual:local": "node scripts/extract-drive-preview-local.mjs",
    "curriculum:merge": "node scripts/merge-curriculum-text.mjs",
    "rag:chunk": "node scripts/chunk-curriculum-text.mjs",
    "rag:embed": "node scripts/embed-curriculum-chunks.mjs",
    "rag:embed:resume": "node scripts/embed-curriculum-chunks.mjs --resume",
    "rag:build": "node scripts/build-rag-index.mjs",
    "rag:build:chunks": "node scripts/build-rag-index.mjs --chunks-only",
    "rag:query": "node scripts/query-rag.mjs",
    "curriculum:prepare": "node scripts/prepare-curriculum-text.mjs",
    "curriculum:review": "node scripts/review-curriculum-quality.mjs",
    "drive:visual:batch": "node scripts/run-drive-visual-local-batch.mjs",
    "content:index": "node scripts/build-curriculum-index.mjs",
    "content:ingest-early": "node scripts/ingest-early-years-pdfs.mjs",
    "content:ingest-pupil-books": "node scripts/ingest-pupil-books.mjs",
    "content:generate": "node scripts/batch-generate-lessons.mjs",
    "content:generate:all": "node scripts/batch-generate-lessons.mjs --all",
    "content:generate:grade": "node scripts/batch-generate-lessons.mjs --grade",
    "content:generate:legacy": "node scripts/batch-generate-revision.mjs",
    "content:generate-exams": "node scripts/batch-generate-exams.mjs",
    "content:generate-exams:all": "node scripts/batch-generate-exams.mjs --all --no-llm",
    "content:generate-exams:grade": "node scripts/batch-generate-exams.mjs --grade",
    "content:ingest-past-papers": "node scripts/ingest-open-past-papers.mjs",
    "content:ingest-past-papers:refresh": "node scripts/ingest-open-past-papers.mjs --refresh",
    "content:rebuild-study": "node scripts/rebuild-all-study-lessons.mjs",
    "content:g8-is-pages": "node scripts/build-g8-integrated-science-pages.mjs",
    "content:g8-is-pages:free2": "node scripts/build-g8-integrated-science-pages.mjs --free-pages 2",
    "textbooks:download": "node scripts/download-textbooks.mjs",
    "textbooks:extract": "node scripts/extract-textbook-text.mjs",
    "textbooks:prepare": "node scripts/download-textbooks.mjs && node scripts/extract-textbook-text.mjs",
    "web:clean": "node scripts/clean-web-next.mjs",
    "web:check-env": "node scripts/check-env.mjs",
    "web:install": "npm --prefix web install",
    "web:catalog": "node scripts/build-web-catalog.mjs",
    "web:dev": "node scripts/check-env.mjs && npm run web:install && npm run web:catalog && npm --prefix web run dev",
    "web:build": "npm run web:install && npm run web:catalog && npm --prefix web run build",
    "web:start": "npm --prefix web run start",
    "setup": "npm install && npm run web:install"
  },
  "dependencies": {
    "apify-client": "^2.12.0",
    "gdown": "^1.0.6"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
