# OpenRouter / OpenAI API (required for RAG + quiz generation)
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_CHAT_MODEL=openai/gpt-4o-mini

# Embeddings file must exist at ../knowledge-base/phase4/curriculum-embeddings.jsonl
# Generate with: npm run rag:embed (from repo root)
